<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>{{documentType}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <script src="https://d3js.org/d3.v5.min.js"></script>
    <style>
        body {

            margin-top: 8%;
            margin-left: 12%;
            width: 50%;
            height: auto;
            font-family: Arial, Helvetica, sans-serif;

        }

        table {
            border-color: black;
        }

        .headerLeft {

            font-size: smaller;
            position: relative;
            top: -0.5vw;
            width: fit-content;
            line-height: 10px;
            margin-top: 20px;
        }

        .headerRight {

            position: relative;
            top: -260px;
            left: 120%;
        }

        .invoice {
            color: rgb(112, 65, 7);
            font-family: Arial, Helvetica, sans-serif;
            font-weight: 100;
        }

        .vl {
            border-left: 2px solid rgba(107, 105, 105, 0.884);
            height: 80px;
            position: relative;
            left: 70%;
            top: -12vw;
        }

        .notify {

            position: relative;
            left: 76%;
            top: -21vw;
            width: 400px;
            height: 15px;

        }

        .Table {

            position: relative;
            top: -6vh;
        }

        th {
            padding: 3px;
            background-color: #715b3d;
            color: #ffffff;
            font-weight: bold;

        }

        tr {
            text-align: center;
            font-size: small;

        }
    </style>
</head>

<body>
    <div>

        <img src="https://i.ibb.co/CMCwjy1/Default-Logo-Cropped.png" alt="logo" width="33%" style="">
       
        <div class="headerLeft">
            

            <p>Shipper: <span style="font-weight: bold;">Wadi Degla for Marble and Granite</span>
            <p>Phone: <span style="font-weight: bold;"> +20 - 106 - 726 - 0314</span></p>
            <p>Website: <span style="font-weight: bold;">https://wadidegla-eg.com</span></p>
            <p>Email: <span style="font-weight: bold;">info@wadidegla-eg.com</span></p>
            <p>Street Address: <span style="line-height: 20px; font-weight: bold;">
                   36, 241D Shaq Althoaban Industrial Area for Marble & Granite, Tourrah, Cairo, Egypt
                <span></p>
        </div>

        <div class="headerRight">
            <h1 class="invoice">{{documentType}}</h1>
            <div style="font-size: smaller; line-height: 15px;">

                 <table border="1"
                    style="font-size: larger;  font-weight: bolder;  position: relative; right: 10vw; border-color:rgba(240, 248, 255, 0) ; width: 25vw; height: 100px; border-collapse:collapse ;">

                    <tr style="background-color: #d9d9d9;">
                        <td style="border-right: 0px; width: 50%; text-align: right; border-color: rgb(0, 0, 0);">
                            PROFORMA INV #
                            </th>
                        <td style="border-left: 0px; border-color:  rgb(0, 0, 0);;">
                            {{proformaInvoice}}
                            </th>
                    </tr>
                    <tr>
                        <td style="border-right: 0px; text-align: right; border-color: rgb(0, 0, 0);;">DATE</th>
                        <td style="border-left: 0px; border-color:  rgb(0, 0, 0);"> {{invoiceDate}}</th>
                    </tr>

                    <td style="border-right: 0px;text-align: right; border-color:  rgb(0, 0, 0);;">CONTAINER #</td>
                    <td style="border-left: 0px;border-color: rgb(0, 0, 0);">{{containerId}}</td>

                    <tr style="background-color: #d9d9d9;">
                        <td style="border-right: 0px; text-align: right; border-color:  rgb(0, 0, 0);">INVOICE #</td>
                        <td style="border-left: 0px;border-color:  rgb(0, 0, 0);">{{invoiceNumber}}</td>
                    </tr>

                </table>

            </div>

        </div>

        <div style="position: relative; top: -170px;">
            <p
                style="width: 75vw; padding: 2px; background-color: #715b3d; color: white; font-family: fantasy; font-weight: 100;">
                CONSIGNIE</p>

            <div style="font-size: small; font-weight: bold; line-height: 30px;">
                <p>Name: {{customerName}}</p>
                <p>Location: {{customerAddress}}</p>
                <p>Telephone: {{customerPhone}} </p>
                <p>RNC: {{rnc}} </p>
            </div>
            <div class="vl"></div>

          <div class="notify">
    <table border="1" style="border-collapse: collapse;">
        <tr>
            <th style="background-color: #ad9571; width: 36.8vw;">NOTIFY</th>
        </tr>
        <tr>
            <td style="font-size: small; line-height: 15px;">
                {{#if notifyContent}}
                    {{notifyContent}}
                {{else}}
                    No specific comment.
                {{/if}}
            </td>
        </tr>
       
    </table>
</div>

            <div class="Table">
                <table border="1" style="margin-bottom: 25px; border-collapse: collapse; width: 75vw;">
                    <tr>
                        <th colspan="3">SHIPPING TERMS</th>
                        <th>PAYMENT TERMS</th>
                    </tr>

                    <tr>
                        <td style=" padding: 10px;">Sea</td>
                        <td style=" padding: 10px;">CIF</td>
                        <td style=" padding: 35px;">{{shippingTerm}}</td>
                        <td>{{PaymentTerms}}</td>
                    </tr>

                </table>
            </div>

            <div class="Table">
                <table border="1" style="border-collapse: collapse; width: 75vw;">
                    <tr>
                        <th style="padding: 8px; width: 2.5%;">#</th>
                        <th style="padding: 8px; width: 40%;">DESCRIPTION</th>
                        <th style="padding: 8px;" colspan="2">SIZE</th>
                        <th style="padding: 8px; width: 10%;">QUANTITY (Units)</th>
                        <th style="padding: 8px;">METERS</th>
                        <th style="padding: 8px;">PRICE</th>
                        <th style="padding: 8px;">TOTAL</th>

                    </tr>
                    {{#each items}}
                    <tr>
                        <td>{{id}}</td>
                        <td>{{description}}</td>
                        <td>{{weight}}</td>
                        <td>{{height}}</td>
                        <td>{{quantity}}</td>
                        <td>{{meters}}</td>
                        <td>{{price}}</td>
                        <td>{{total}}</td>
                    </tr>

                    {{/each}}


                </table>

                <div>
                    <table border="1" style="border-collapse: collapse; width: 75vw;">
                        <tr>
                            <td style="padding: 15px; font-weight: normal; color:rgb(31, 30, 30); background-color: #a9d08e; width: 43.5%;">
                                Other Comments or Special Instructions
                            </td>
                            
                              <td colspan="2" style="font-weight: bold; border-color: rgb(0, 0, 0);text-align: center;">
                                {{#if comment}}
                                    {{comment}}
                                {{else}}
                                    No comments or special instructions.
                                {{/if}}</td>             
                        </tr>

                        <tr>                             
                            <td
                                style=" border-color: rgb(0, 0, 0);">
                                Shipment Total {{shipmentTotalContainers}} Containers
                            </td>
                            <td
                                style="  font-weight: bold; border-color: rgb(0, 0, 0);">
                                Shipment fees</td>
                                <td
                                style="padding: 3px; text-align: center;  border-color: rgb(0, 0, 0);">
                                {{shipmentFees}}</td>
                        </tr>
                        <tr>
                            <td style="border-color: rgb(0, 0, 0);">Total {{totalBoxes}} Boxes</td>
                            <td
                                style="  font-weight: bold;  border-color: rgb(0, 0, 0)">
                                Discount</td>
                        
                            <td
                                style="padding: 3px; text-align: center;  border-color: rgb(0, 0, 0);">
                                {{discount}}</td>

                          
                        </tr>
                        <tr>
                            <td style="background-color: #a9d08e; border-color: rgb(0, 0, 0);">NET WEIGHT {{netWeight}}</td>
                            <td
                                style=" background-color: #a9d08e; font-weight: bold;  border-color: rgb(0, 0, 0)">
                                TOTAL</td>

                            <td
                                style="padding: 3px; text-align: center; background-color: #a9d08e; border-color: rgb(0, 0, 0);">
                                {{total}}</td>
                            
                        </tr>
                        <tr>
                            <td style="background-color: #d9d9d9; border-color: rgb(0, 0, 0);">GROSS WEIGHT {{grossWeight}}</td>
                            <td 
                                style=" background-color: #d9d9d9; font-weight: bold;  border-color: rgb(0, 0, 0);">
                                TOTAL METERS m2</td>
                            <td
                                style="padding: 3px; text-align: center; background-color: #d9d9d9; border-color: rgb(0, 0, 0);">
                                {{totalMeters}}</td>
                        </tr>
                    </table>
                </div>
                <p
                    style="text-align: center; width: 150%; font-size: medium; text-decoration-line: underline; margin-top: 10%;">
                    {{packingInfo}}
                </p>
                <div style="line-height: 4px; margin-top: 10%;">
                    <p style="font-weight: bold; width: 100%; font-size: small;">Make all checks Payable to WADI DEGLA
                        FOR MARBLE AND GRANITE</p>
                    <p style="font-weight: bold; width: 100%; font-size: small;">AC No: 1702254949110012</p>
                    <p style="font-weight: bold; width: 100%; font-size: small;">IBAN: EG350023001701702254949110012</p>
                    <p style="font-weight: bold; width: 100%; font-size: small;">Bank: AL WATANY BANK OF EGYPT NATIONAL
                        BANK OF KUWAIT</p>
                    <p style="font-weight: bold; width: 100%; font-size: small;">Branch: Maadi Branch</p>
                    <p style="font-weight: bold; width: 100%; font-size: small;">Swift: WABAEGCXXXX</p>
                </div>

                {{!-- <img src="https://i.ibb.co/rF9vDBw/Logo2.jpg" alt="logo" width="60%"
                    style="position: relative; left: 100%; top: -18vw;"> --}}

                <div
                    style="line-height: 5px; position: relative; top: 4vw; width: 150%; text-align: center; font-size: smaller;">
                    <p>For questions about this shipment, please contact</p>
                    <p>Wadi Degla Phone &nbsp;&nbsp; +20 - 106 - 726 - 0314 &nbsp;&nbsp; E-mail: info@wadidegla-eg.com
                    </p>
                    <p>Scan QR Code for other contacts</p>
                    <p style="font-size: small; font-weight: bold;">Thank You!
                    </p>

                    <img src="https://i.ibb.co/mNNLC42/QR-code.jpg" alt="qr-code" width="15%"
                        style="position: relative; left: 42%; top: -11vw;">

                </div>
            </div>


        </div>




    </div>
</body>